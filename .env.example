# Public API base for the mutual-aid backend (Lambda via api.verifiednepal.com).
# The frontend sends Google ID tokens to this origin; keep it empty in local dev
# if you only want the read-only snapshot to render offline.
VITE_API_BASE=

# Google OAuth client ID for the "The Desk" sign-in (GIS). Leave empty to show
# the muted "sign-in not configured yet" state on /desk.
VITE_GOOGLE_CLIENT_ID=

# Optional chat widget (dev defaults are in .env; override here if needed)
VITE_CHAT_WIDGET_SRC=
VITE_CHAT_KEY=
VITE_CHAT_API=

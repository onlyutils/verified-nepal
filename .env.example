# Public API base for the mutual-aid backend (Lambda via api.verifiednepal.com).
# The frontend sends OnlyUtils access tokens to this origin; keep it empty in local dev
# if you only want the read-only snapshot to render offline.
VITE_API_BASE=

# OnlyUtils client id for the "The Desk" sign-in (Authorization Code + PKCE, S256). Leave empty to show
# the muted "sign-in not configured yet" state on /desk.
# dev = ou_client_34HIKupJ5afWl0DIoh7zi
VITE_OU_CLIENT_ID=

# Cloudflare Turnstile site key (public) for the anonymous forms. Leave empty to render the forms
# without the widget; the API only enforces it when TURNSTILE_SECRET is set on the Lambda.
# dev/prod share one widget: 0x4AAAAAAEkBp90mEl2o4Ebs (hostnames verifiednepal.com, dev., localhost)
VITE_TURNSTILE_SITE_KEY=

# Optional chat widget (dev defaults are in .env; override here if needed)
VITE_CHAT_WIDGET_SRC=
VITE_CHAT_KEY=
VITE_CHAT_API=
